# Virtual environments (CRITICAL: never commit .venv)
.venv/
env/
venv/
ENV/

# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class
*.so

# IDE / Editor configuration
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Jupyter Notebook checkpoints (if used)
.ipynb_checkpoints/

# Profiling / testing / coverage
.pytest_cache/
.coverage
htmlcov/

# Ignore everything inside of data
data/**/*

# Allow git to search subfolders for exceptions
!data/**/

# Minus .gitkeep (to keep the folder structure in git)
!data/**/.gitkeep